# Copy to `.env` (git-ignored) and load it before running the demo:
#   set -a && source .env && set +a && npm --prefix scripts run demo

# Address of the deployed program (output of `solana program deploy`).
PROGRAM_ID=<your-program-id>

# Any Solana Devnet RPC endpoint.
RPC_URL=https://api.devnet.solana.com

# Path to the payer keypair JSON. Optional: defaults to `keypair_path` from
# ~/.config/solana/cli/config.yml, then ~/.config/solana/id.json.
# KEYPAIR=~/.config/solana/deployer.json

# Optional: campaign duration used by the demo, in seconds.
DEADLINE_SECONDS=20
